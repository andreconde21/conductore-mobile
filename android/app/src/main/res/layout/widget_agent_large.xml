<?xml version="1.0" encoding="utf-8"?>
<!-- 4x2: the dashboard's counts (needs you, stuck, working, done), the
     top lines needing you or stuck, and the limit rings. The colours are
     the defaults (Everforest); the provider applies the app theme's. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:id="@+id/widget_surface"
        style="@style/AgentWidgetSurface"
        android:src="@drawable/agent_widget_fill"
        android:tint="@color/agent_widget_surface" />

    <ImageView
        android:id="@+id/widget_border"
        style="@style/AgentWidgetSurface"
        android:src="@drawable/agent_widget_stroke"
        android:tint="@color/agent_widget_border" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="14dp"
        android:paddingTop="8dp"
        android:paddingEnd="10dp"
        android:paddingBottom="8dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/widget_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:text="@string/agent_widget_title"
                android:textColor="@color/agent_widget_on_surface"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/widget_as_of"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/agent_widget_on_surface_variant"
                android:textSize="11sp" />

            <LinearLayout
                android:id="@+id/widget_rings"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <FrameLayout
                    android:id="@+id/widget_ring_5h"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:layout_marginStart="6dp"
                    android:visibility="gone">

                    <ImageView
                        android:id="@+id/widget_ring_5h_image"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:importantForAccessibility="no" />

                    <TextView
                        android:id="@+id/widget_ring_5h_text"
                        style="@style/AgentWidgetRingText" />
                </FrameLayout>

                <FrameLayout
                    android:id="@+id/widget_ring_7d"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:layout_marginStart="6dp"
                    android:visibility="gone">

                    <ImageView
                        android:id="@+id/widget_ring_7d_image"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:importantForAccessibility="no" />

                    <TextView
                        android:id="@+id/widget_ring_7d_text"
                        style="@style/AgentWidgetRingText" />
                </FrameLayout>
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/widget_counts"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:orientation="horizontal">

            <LinearLayout
                android:id="@+id/widget_cell_needs"
                style="@style/AgentWidgetCountCell">

                <TextView
                    android:id="@+id/widget_count_needs"
                    style="@style/AgentWidgetCount"
                    android:textColor="@color/agent_widget_accent" />

                <TextView
                    android:id="@+id/widget_caption_needs"
                    style="@style/AgentWidgetCountCaption"
                    android:text="@string/agent_widget_caption_need_you" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/widget_cell_stuck"
                style="@style/AgentWidgetCountCell">

                <TextView
                    android:id="@+id/widget_count_stuck"
                    style="@style/AgentWidgetCount"
                    android:textColor="@color/agent_widget_warning" />

                <TextView
                    android:id="@+id/widget_caption_stuck"
                    style="@style/AgentWidgetCountCaption"
                    android:text="@string/agent_widget_caption_stuck" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/widget_cell_working"
                style="@style/AgentWidgetCountCell">

                <TextView
                    android:id="@+id/widget_count_working"
                    style="@style/AgentWidgetCount"
                    android:textColor="@color/agent_widget_on_surface" />

                <TextView
                    android:id="@+id/widget_caption_working"
                    style="@style/AgentWidgetCountCaption"
                    android:text="@string/agent_widget_caption_working" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/widget_cell_done"
                style="@style/AgentWidgetCountCell">

                <TextView
                    android:id="@+id/widget_count_done"
                    style="@style/AgentWidgetCount"
                    android:textColor="@color/agent_widget_on_surface_variant" />

                <TextView
                    android:id="@+id/widget_caption_done"
                    style="@style/AgentWidgetCountCaption"
                    android:text="@string/agent_widget_caption_done" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:id="@+id/widget_empty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:ellipsize="end"
            android:maxLines="2"
            android:text="@string/agent_widget_empty"
            android:textColor="@color/agent_widget_on_surface_variant"
            android:textSize="13sp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/widget_line_1"
            style="@style/AgentWidgetRow"
            android:layout_marginTop="4dp" />

        <TextView
            android:id="@+id/widget_line_2"
            style="@style/AgentWidgetRow" />

        <TextView
            android:id="@+id/widget_line_3"
            style="@style/AgentWidgetRow" />
    </LinearLayout>
</FrameLayout>
